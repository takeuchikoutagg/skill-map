# バックエンドの、本番用の環境変数の見本。
# 使うときは、このファイルを .env.production にコピーして、値を埋める
# (.env.production は Git に入らない。秘密の値を、書いて良い)。
#
# docker-compose.prod.yml が、この名前のファイルを読み込む(env_file)。

# Rails のマスターキー(config/master.key の中身。秘密の値。EC2 の上だけに置く)
RAILS_MASTER_KEY=

# DB(RDS)の接続先。docker-compose.prod.local.yml を重ねてローカルで確認するときは、
# DB_HOST=db、DB_USER=root に、そちらのファイルが自動で上書きする(ここは空のままでよい)
DB_HOST=
DB_USER=backend
DB_PASSWORD=

# HTTPS(SSL)を使うかどうか。Nginx が HTTP だけを受ける、いまの構成では false のまま
# (true にすると、無限リダイレクトになる。backend/config/environments/production.rb を参照)
FORCE_SSL=false

# CORS の許可オリジン。本番は、Nginx が同じオリジンで振り分けるため、実質使わない
# (ブラウザから API へ、直接ではなく、同じオリジン経由で呼ぶため)。既定値のままでよい
# CORS_ORIGINS=
