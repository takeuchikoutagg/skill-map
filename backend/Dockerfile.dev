# 開発用のイメージ(本番用は、同じフォルダの Dockerfile)
# Ruby のバージョンは .ruby-version と合わせる
ARG RUBY_VERSION=3.4.10
FROM docker.io/library/ruby:${RUBY_VERSION}-slim

WORKDIR /rails

# mysql2 のビルドに必要なもの、MySQL のクライアント(db:prepare や動作確認用)
RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y \
      build-essential curl default-libmysqlclient-dev default-mysql-client git libyaml-dev pkg-config && \
    rm -rf /var/lib/apt/lists /var/cache/apt/archives

# gem は先にインストールする(Gemfile が変わらない限り、再ビルドで使い回される)
COPY Gemfile Gemfile.lock ./
RUN bundle install

# アプリのコードは、docker-compose.yml で ./backend をマウントする
EXPOSE 3000
CMD ["bin/rails", "server", "-b", "0.0.0.0", "-p", "3000"]
