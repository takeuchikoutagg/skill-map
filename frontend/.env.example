# フロントエンドの設定の見本。変えたいときは、このファイルを .env.local にコピーして使う
# (.env.local は Git に入らない。なくても、下の既定値で動く)

# API(バックエンド)の場所
#   NEXT_PUBLIC_API_URL … ブラウザから API を呼ぶときの場所(NEXT_PUBLIC_ で始まる値は、ブラウザに公開される)
#   API_URL             … Next.js のサーバーから API を呼ぶときの場所
# 開発中は、どちらも同じ(バックエンドは、3001 番で動く)
NEXT_PUBLIC_API_URL=http://localhost:3001
API_URL=http://localhost:3001
