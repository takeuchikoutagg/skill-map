# 変数の見本。使うときは、このファイルを terraform.tfvars にコピーして、値を埋める
# (terraform.tfvars は、.gitignore で、Git に入らない)。

aws_region    = "ap-northeast-1"
my_ip         = "203.0.113.1/32" # あなたの、いまの IP アドレス(私が確認します。docs/07 の C7)
key_pair_name = "skill-map"      # EC2 を作る前に、コンソールで作っておく、キーペアの名前(docs/07 の P5)

# db_password は、ここには書かない(秘密の値)。
# terraform apply のときに、対話的に入力するか、環境変数で渡す:
#   TF_VAR_db_password="..." terraform apply
